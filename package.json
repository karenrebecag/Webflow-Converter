{
  "name": "webflow-converter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Converts React + Tailwind components into Webflow's native clipboard format (@webflow/XscpData)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karenrebecag/Webflow-Converter.git"
  },
  "scripts": {
    "test": "bun --no-install test",
    "convert": "bun --no-install run src/cli.ts convert",
    "copy-page": "bun --no-install run tools/copy-page.ts"
  },
  "dependencies": {
    "@relume_io/relume-tailwind": "1.3.0",
    "@tailwindcss/typography": "0.5.15",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7"
  }
}
